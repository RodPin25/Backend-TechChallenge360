# Configuraciones de entorno para la aplicacion
NODE_ENV=development
API_PORT=3000

# Configuraciones de la base de datos (SQL Server 2019+)
DB_HOST="HOST SQL SERVER || localhost"
DB_PORT=1433
DB_USER="USUARIO_SQL || sa"
DB_PASSWORD="TU_PASSWORD_SQL"
DB_NAME="ShopCartDB"

# Configuraciones de Redis
REDIS_HOST="localhost || HOST_REDIS"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Configuraciones de JWT
JWT_SECRET="SECRETO_PARA_ACCESS_TOKEN_MINIMO_16_CARACTERES"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="SECRETO_PARA_REFRESH_TOKEN_MINIMO_16_CARACTERES"
JWT_REFRESH_EXPIRES_IN="7d"

# Constantes de negocio
IVA_RATE=0.12
RESERVATION_TTL_MINUTES=15
